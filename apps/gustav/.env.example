# Copy to .env.local (or export in your shell) before `npm run start`.
# The anon key is meant to ship in the client (Supabase Project Settings →
# API) — the service-role key never belongs here.
#
# If EXPO_PUBLIC_SUPABASE_URL is unset, the app falls back to the hosted
# Gustav project (see src/lib/env.ts). Only set it to a localhost URL here
# if you deliberately want to point at `supabase start` for local dev.
EXPO_PUBLIC_SUPABASE_URL=https://hlcxzxzefpltvmphospv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
