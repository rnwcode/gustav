# Kopie als .env anlegen. .env ist in .gitignore und gehört NIEMALS ins Repo.
# Werte erzeugen: openssl rand -base64 48

############ Postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

############ JWT — beide aus dem JWT_SECRET ableiten
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

############ Studio / API
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

############ Auth
DISABLE_SIGNUP=false
ENABLE_ANONYMOUS_USERS=true
ENABLE_EMAIL_AUTOCONFIRM=true

############ SMTP — erst nötig, wenn es Accounts gibt
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Hundeplaner
SMTP_ADMIN_EMAIL=

############ LLM — nur serverseitig, nie in der App
LLM_API_KEY=
LLM_ENDPOINT=
