# Kopie als .env anlegen. .env ist in .gitignore und gehört NIEMALS ins Repo.
# Werte stehen im Supabase-Dashboard unter Project Settings → API.

############ Projekt
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=                 # darf in die App
SUPABASE_SERVICE_ROLE_KEY=         # NUR serverseitig — niemals in den Client
SUPABASE_PROJECT_REF=

############ Lokal (supabase start) — feste Werte der CLI
LOCAL_SUPABASE_URL=http://localhost:54321
LOCAL_ANON_KEY=

############ Deployment
SUPABASE_ACCESS_TOKEN=             # für CI, aus dem Dashboard

############ LLM — nur in Edge Functions, nie in der App
LLM_API_KEY=
LLM_ENDPOINT=
