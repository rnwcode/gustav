# Copy to infra/llm/.env and fill in a real value before `docker compose up`.
# The same value must be set as LLM_API_KEY for `supabase functions serve`
# (infra/llm/README.md) — the auth proxy (Caddyfile) rejects every request
# whose Authorization header doesn't match.
LLM_API_KEY=change-me-to-a-random-string
